# Copy to .env.local before running `docker-compose up`
POSTGRES_PASSWORD=postgres

# Generate a strong 256-bit secret: `openssl rand -base64 64`
JWT_SECRET=REDACTED

# Generate two JWTs signed with JWT_SECRET and payloads {"role":"anon"} and {"role":"service_role"}
# You can keep the defaults below for local-only development.
SUPABASE_ANON_KEY=REDACTED
SUPABASE_SERVICE_ROLE_KEY=REDACTED
